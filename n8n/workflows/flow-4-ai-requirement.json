    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item.json;\nconst raw = item.content || item.text || item.response || (item.parts && item.parts[0]?.text) || (item.message?.content) || '';\nlet str = typeof raw === 'string' ? raw : JSON.stringify(raw);\n\n// Làm sạch markdown code fences nếu LLM trả về ```json\nstr = str.replace(/```(?:json)?/gi, '').replace(/```/g, '').trim();\n\nlet parsed = null;\nlet isValidSchema = false;\nlet schemaErrorDetails = '';\n\ntry {\n  parsed = JSON.parse(str);\n} catch (err) {\n  const firstBrace = str.indexOf('{');\n  const lastBrace = str.lastIndexOf('}');\n  if (firstBrace !== -1 && lastBrace > firstBrace) {\n    try {\n      parsed = JSON.parse(str.substring(firstBrace, lastBrace + 1));\n    } catch (innerErr) {\n      schemaErrorDetails = 'Không thể parse JSON từ kết quả của AI: ' + err.message;\n    }\n  } else {\n    schemaErrorDetails = 'Không tìm thấy cấu trúc JSON hợp lệ trong phản hồi của AI: ' + err.message;\n  }\n}\n\nlet sanitizedEpics = [];\nlet totalStories = 0;\nlet totalTasks = 0;\n\nif (parsed) {\n  const epics = parsed.epics || (Array.isArray(parsed) ? parsed : (parsed.data?.epics || null));\n  if (Array.isArray(epics) && epics.length > 0) {\n    sanitizedEpics = epics.map((epic, ei) => {\n      const title = String(epic.title || epic.name || epic.epic_name || `Epic #${ei + 1}`).trim();\n      const description = String(epic.description || epic.details || epic.desc || '').trim();\n      const rawStories = epic.stories || epic.user_stories || epic.userStories || [];\n\n      const sanitizedStories = (Array.isArray(rawStories) ? rawStories : []).map((story, si) => {\n        const sTitle = String(story.title || story.name || story.user_story || `User Story #${si + 1}`).trim();\n        const sDesc = String(story.description || story.desc || '').trim();\n        const rawTasks = story.tasks || story.subtasks || [];\n\n        const sanitizedTasks = (Array.isArray(rawTasks) ? rawTasks : []).map((task, ti) => {\n          if (typeof task === 'string') {\n            return {\n              title: task.trim(),\n              description: ''\n            };\n          }\n          return {\n            title: String(task.title || task.name || `Task #${ti + 1}`).trim(),\n            description: String(task.description || task.desc || '').trim()\n          };\n        });\n\n        totalTasks += sanitizedTasks.length;\n        return {\n          title: sTitle,\n          description: sDesc,\n          tasks: sanitizedTasks\n        };\n      });\n\n      totalStories += sanitizedStories.length;\n      return {\n        title: title,\n        description: description,\n        stories: sanitizedStories\n      };\n    });\n\n    isValidSchema = true;\n  } else {\n    schemaErrorDetails = 'Cấu trúc phản hồi thiếu mảng epics hoặc mảng epics rỗng.';\n  }\n}\n\nif (isValidSchema) {\n  const startMs = item.timestamp ? new Date(item.timestamp).getTime() : Date.now();\n  const durationMs = Math.max(Date.now() - startMs, 10);\n\n  return {\n    json: {\n      success: true,\n      epics: sanitizedEpics,\n      metadata: {\n        requestId: item.requestId,\n        projectId: item.projectId || null,\n        userId: item.userId || 'system-user',\n        model: 'models/gemini-1.5-flash',\n        totalEpics: sanitizedEpics.length,\n        totalStories: totalStories,\n        totalTasks: totalTasks,\n        processedAt: new Date().toISOString(),\n        durationMs: durationMs\n      },\n      isValidSchema: true\n    }\n  };\n} else {\n  return {\n    json: {\n      isValidSchema: false,\n      schemaErrorDetails: schemaErrorDetails,\n      rawOutput: str ? str.slice(0, 300) : '',\n      requestId: item.requestId,\n      timestamp: item.timestamp,\n      projectId: item.projectId,\n      userId: item.userId\n    }\n  };\n}"
      },

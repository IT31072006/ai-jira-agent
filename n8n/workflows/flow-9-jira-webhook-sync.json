    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Idempotency: Kiểm tra chống lặp sự kiện và xác định trạng thái chuyển dịch\nconst statusNorm = String(item.status || 'To Do').trim();\nconst dateStamp = new Date().toISOString().slice(0, 10);\nconst idempotencyKey = `IDEMP-${item.issueKey}-${statusNorm.replace(/\\s+/g, '_')}-${dateStamp}`;\n\n// Phân định Status Category chuẩn Jira\nlet category = 'To Do';\nif (statusNorm.toLowerCase().includes('done') || statusNorm.toLowerCase().includes('hoàn thành')) {\n  category = 'Done';\n} else if (statusNorm.toLowerCase().includes('progress') || statusNorm.toLowerCase().includes('tiến hành')) {\n  category = 'In Progress';\n}\n\nconst isTransitionToDone = category === 'Done';\n\nreturn [{\n  json: {\n    ...item,\n    category,\n    idempotencyKey,\n    isTransitionToDone,\n    stage: 'IDEMPOTENCY_VERIFIED'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        -100
      ],
      "id": "f9-node-5-idempotency",
      "name": "Node 5 - Idempotency & State Delta Checker"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "assign-sql-upsert",
              "name": "postgresUpsertPayload",
              "value": "={{ {\n  issue_key: $json.issueKey,\n  project_key: $json.projectKey || $json.issueKey.split('-')[0],\n  summary: $json.summary,\n  status: $json.status,\n  status_category: $json.category,\n  assignee: $json.assignee,\n  updated_at: $now.toISO(),\n  idempotency_key: $json.idempotencyKey\n} }}",
              "type": "object"
            },
            {
              "id": "assign-db-sync-state",
              "name": "dbSyncAction",
              "value": "UPSERT_JIRA_ISSUES_TABLE",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        200,
        -100
      ],
      "id": "f9-node-6-format-db",
      "name": "Node 6 - Format PostgreSQL Upsert Record"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\n// Tính toán lại chỉ số KPI và tiến độ dự án\nconst baseTotal = 14;\nlet currentDone = item.isTransitionToDone ? 9 : 8;\nconst completionRate = Math.round((currentDone / baseTotal) * 100);\nconst progressDelta = item.isTransitionToDone ? '+7.1% (Tăng thêm 1 Task)' : 'Duy trì trạng thái';\n\nreturn [{\n  json: {\n    ...item,\n    kpiSummary: {\n      totalIssues: baseTotal,\n      doneIssues: currentDone,\n      completionRate,\n      progressDelta,\n      activeSprints: 1\n    },\n    stage: 'KPI_RECALCULATED'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        -100
      ],
      "id": "f9-node-7-recalculate-kpi",
      "name": "Node 7 - Recalculate Project KPI & Completion Rate"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst kpi = item.kpiSummary || {};\n\n// AI Progress Narrative: Tự động tổng hợp thông điệp tiến độ thời gian thực\nlet narrative = `Task [${item.issueKey}] \"${item.summary}\" vừa được cập nhật sang trạng thái [${item.status}] bởi ${item.assignee}.`;\nif (item.isTransitionToDone) {\n  narrative = `🎉 CHÚC MỪNG: Kỹ sư ${item.assignee} đã hoàn thành xuất sắc task [${item.issueKey}] \"${item.summary}\"! Tiến độ dự án ${item.projectKey || ''} đã tăng lên ${kpi.completionRate}% (${kpi.doneIssues}/${kpi.totalIssues} tasks hoàn tất).`;\n} else {\n  narrative = `⚡ CẬP NHẬT TIẾN ĐỘ: Task [${item.issueKey}] đang được thực hiện tích cực bởi ${item.assignee}. Trạng thái hiện tại: [${item.status}].`;\n}\n\nreturn [{\n  json: {\n    ...item,\n    aiNarrative: narrative,\n    standupBroadcastNote: `[Daily Standup Sync] ${item.issueKey} -> ${item.status}`,\n    stage: 'AI_NARRATIVE_GENERATED'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -100
      ],
      "id": "f9-node-8-ai-narrative",
      "name": "Node 8 - AI Progress Narrative & Standup Update"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst kpi = item.kpiSummary || {};\n\n// Chuẩn bị payload thông báo đa kênh cho Discord / Slack / Email\nconst statusColor = item.isTransitionToDone ? 3584894 : 2097356; // Xanh lá vs Xanh dương\n\nconst discordPayload = {\n  username: 'Jira Cloud Real-time Agent',\n  avatar_url: 'https://cdn-icons-png.flaticon.com/512/5968/5968875.png',\n  embeds: [\n    {\n      title: `🔔 [Đồng bộ Webhook] Cập nhật ${item.issueKey}: ${item.status}`,\n      description: item.aiNarrative,\n      color: statusColor,\n      fields: [\n        { name: 'Mã công việc', value: item.issueKey, inline: true },\n        { name: 'Người phụ trách', value: item.assignee, inline: true },\n        { name: 'Tiến độ dự án', value: `${kpi.completionRate}% (${kpi.progressDelta})`, inline: true }\n      ],\n      footer: { text: `Đồng bộ hai chiều Atlassian Webhook • ${new Date().toLocaleTimeString('vi-VN')}` }\n    }\n  ]\n};\n\nconst emailSummary = {\n  subject: `[Jira Status Sync] ${item.issueKey} chuyển sang ${item.status}`,\n  bodyText: item.aiNarrative\n};\n\nreturn [{\n  json: {\n    ...item,\n    discordPayload,\n    emailSummary,\n    stage: 'ALERT_PAYLOADS_FORMED'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        -100
      ],

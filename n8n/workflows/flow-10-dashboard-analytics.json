    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst summary = item.summary || {};\nconst status = item.status || {};\n\nconst totalIssues = summary.totalIssues !== undefined ? summary.totalIssues : (status.total || 0);\nconst doneIssues = status.done !== undefined ? status.done : (summary.statusDistribution?.done || 0);\nconst inProgressIssues = status.inProgress !== undefined ? status.inProgress : (summary.statusDistribution?.inProgress || 0);\nconst toDoIssues = status.toDo !== undefined ? status.toDo : (summary.statusDistribution?.toDo || 0);\n\n// Tính tỷ lệ hoàn thành chính xác tuyệt đối, tránh lỗi chia cho 0\nconst rawRate = totalIssues > 0 ? (doneIssues / totalIssues) * 100 : 0;\nconst completionRate = parseFloat(rawRate.toFixed(1));\n\n// Thống kê Story Points theo tiêu chuẩn Agile ước tính\nconst totalStoryPoints = summary.totalStoryPoints || ((summary.totalStories || 0) * 5 + (summary.totalTasks || 0) * 2);\nconst completedStoryPoints = Math.round((totalStoryPoints * completionRate) / 100);\n\nconst completionMetrics = {\n  totalIssues,\n  doneIssues,\n  inProgressIssues,\n  toDoIssues,\n  completionRate,\n  formattedPercentage: `${completionRate}%`,\n  totalStoryPoints,\n  completedStoryPoints,\n  formula: '(Số issue Done ÷ Tổng số issue) × 100%',\n  isZeroState: totalIssues === 0,\n  calculatedAt: new Date().toISOString()\n};\n\nreturn [{\n  json: {\n    ...item,\n    completionMetrics,\n    stage: 'METRICS_CALCULATED'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2300,
        0
      ],
      "id": "f10-main-09-calc-metrics",
      "name": "MAIN 09 — Calculate Completion Metrics"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst { summary, status, breakdown, trend, completionMetrics, verifiedProject, requestId } = item;\n\n// 1. Chuẩn hóa Status Distribution với mã màu và nhãn tiếng Việt phục vụ Pie/Donut Chart\nconst normalizedDistribution = [\n  {\n    status: 'To Do',\n    label: 'Cần làm (To Do)',\n    count: completionMetrics.toDoIssues,\n    percentage: completionMetrics.totalIssues > 0 ? parseFloat(((completionMetrics.toDoIssues / completionMetrics.totalIssues) * 100).toFixed(1)) : 0,\n    color: '#64748b'\n  },\n  {\n    status: 'In Progress',\n    label: 'Đang thực hiện (In Progress)',\n    count: completionMetrics.inProgressIssues,\n    percentage: completionMetrics.totalIssues > 0 ? parseFloat(((completionMetrics.inProgressIssues / completionMetrics.totalIssues) * 100).toFixed(1)) : 0,\n    color: '#3b82f6'\n  },\n  {\n    status: 'Done',\n    label: 'Hoàn thành (Done)',\n    count: completionMetrics.doneIssues,\n    percentage: completionMetrics.totalIssues > 0 ? parseFloat(((completionMetrics.doneIssues / completionMetrics.totalIssues) * 100).toFixed(1)) : 0,\n    color: '#10b981'\n  }\n];\n\n// 2. Chuẩn hóa Summary DTO\nconst normalizedSummary = {\n  totalProjects: summary.totalProjects || 0,\n  totalEpics: summary.totalEpics || 0,\n  totalStories: summary.totalStories || 0,\n  totalTasks: summary.totalTasks || 0,\n  totalIssues: completionMetrics.totalIssues,\n  totalStoryPoints: completionMetrics.totalStoryPoints,\n  issuesThisMonth: summary.issuesThisMonth || 0,\n  epicsThisMonth: summary.epicsThisMonth || 0,\n  storiesThisMonth: summary.storiesThisMonth || 0,\n  tasksThisMonth: summary.tasksThisMonth || 0,\n  completionRate: completionMetrics.completionRate,\n  statusDistribution: {\n    toDo: completionMetrics.toDoIssues,\n    inProgress: completionMetrics.inProgressIssues,\n    done: completionMetrics.doneIssues\n  },\n  timeWindow: summary.timeWindow || {\n    monthStart: new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString(),\n    nextMonthStart: new Date(new Date().getFullYear(), new Date().getMonth() + 1, 1).toISOString(),\n    timezone: 'UTC'\n  },\n  filteredProject: verifiedProject || summary.filteredProject || null\n};\n\n// 3. Chuẩn hóa Status DTO\nconst normalizedStatus = {\n  total: completionMetrics.totalIssues,\n  done: completionMetrics.doneIssues,\n  inProgress: completionMetrics.inProgressIssues,\n  toDo: completionMetrics.toDoIssues,\n  completionRate: completionMetrics.completionRate,\n  denominatorNote: 'Mẫu số tính tỷ lệ hoàn thành là tổng số Issue trong phạm vi truy cập (To Do + In Progress + Done)',\n  distribution: normalizedDistribution\n};\n\n// 4. Chuẩn hóa Breakdown DTO phục vụ BarChart\nconst normalizedBreakdown = breakdown.breakdown ? breakdown : {\n  breakdown: [\n    { type: 'Epic', name: 'Epics', thisMonth: summary.epicsThisMonth || 0, allTime: summary.totalEpics || 0 },\n    { type: 'Story', name: 'Stories', thisMonth: summary.storiesThisMonth || 0, allTime: summary.totalStories || 0 },\n    { type: 'Task', name: 'Tasks / Sub-tasks', thisMonth: summary.tasksThisMonth || 0, allTime: summary.totalTasks || 0 }\n  ],\n  totals: breakdown.totals || {\n    thisMonth: (summary.epicsThisMonth || 0) + (summary.storiesThisMonth || 0) + (summary.tasksThisMonth || 0),\n    allTime: (summary.totalEpics || 0) + (summary.totalStories || 0) + (summary.totalTasks || 0)\n  }\n};\n\n// 5. Chuẩn hóa Creation Trend DTO phục vụ AreaChart/LineChart\nconst normalizedTrend = trend.trend ? trend : {\n  month: new Date().toISOString().slice(0, 7),\n  totalInMonth: summary.issuesThisMonth || 0,\n  trend: []\n};\n\nreturn [{\n  json: {\n    ...item,\n    normalizedSummary,\n    normalizedStatus,\n    normalizedBreakdown,\n    normalizedTrend,\n    stage: 'RESULTS_NORMALIZED'\n  }\n}];"
      },

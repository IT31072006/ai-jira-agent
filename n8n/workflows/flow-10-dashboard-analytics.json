        "jsCode": "const item = $input.first().json;\nconst body = item.body || item;\n\nconst userId = String(body.userId || '').trim();\nconst projectId = body.projectId ? String(body.projectId).trim() : null;\nconst requestId = String(body.requestId || ('req-dash-' + Date.now()));\nconst timestamp = body.timestamp || new Date().toISOString();\nconst backendUrl = String(body.backendUrl || 'http://localhost:5000').replace(/\\/+$/, '');\nconst internalSecret = String(body.internalSecret || 'ai_jira_agent_internal_secret_2026');\n\n// Kiểm tra tính hợp lệ tối thiểu của request: Bắt buộc phải có userId xác thực\nconst isValid = Boolean(userId && userId.length > 0);\n\nreturn [{\n  json: {\n    userId,\n    projectId,\n    requestId,\n    timestamp,\n    backendUrl,\n    internalSecret,\n    isValid,\n    stage: 'INBOUND_NORMALIZED'\n  }\n}];"

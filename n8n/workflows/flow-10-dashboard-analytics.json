      "id": "f10-main-07-fetch-trend",
      "name": "MAIN 07 — Fetch Issue Creation Trend"
    },
    {
      "parameters": {
        "jsCode": "const trendRes = $input.first().json;\nconst prevState = $('AUX — MAIN 06 — Preserve Issue Breakdown').first().json;\n\nconst summary = prevState.summaryData || {};\nconst status = prevState.statusData || {};\nconst breakdown = prevState.breakdownData || {};\nconst trend = trendRes.data || trendRes || {};\n\n// Kiểm tra tính đầy đủ và hợp lệ của các tập dữ liệu thống kê\nconst errors = [];\nif (typeof summary.totalIssues !== 'number' || summary.totalIssues < 0) {\n  errors.push('Tổng số Issue không hợp lệ hoặc âm trong summary dataset.');\n}\nif (typeof status.total !== 'number' || status.total < 0) {\n  errors.push('Tổng số trạng thái không hợp lệ trong status distribution dataset.');\n}\nif (!Array.isArray(breakdown.breakdown)) {\n  errors.push('Dữ liệu phân loại Issue Breakdown không phải là mảng hợp lệ.');\n}\nif (!Array.isArray(trend.trend)) {\n  errors.push('Dữ liệu xu hướng Creation Trend không phải là mảng hợp lệ.');\n}\n\nconst datasetValid = errors.length === 0;\n\nreturn [{\n  json: {\n    ...prevState,\n    summary,\n    status,\n    breakdown,\n    trend,\n    datasetValid,\n    validationErrors: errors,\n    stage: 'DATASETS_AGGREGATED'\n  }\n}];"
